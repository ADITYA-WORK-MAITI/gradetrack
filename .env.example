# MySQL DSN for github.com/go-sql-driver/mysql
DB_DSN=root:yourpassword@tcp(127.0.0.1:3306)/gradetrack?parseTime=true
# Secret used to sign JWTs — use a long random string
JWT_SECRET=change-me-to-a-long-random-string
# Port for the API server (optional, default 8080)
PORT=8080
# Exact origin allowed by CORS (the frontend). No wildcard.
FRONTEND_ORIGIN=http://localhost:5173
# "production" tightens the Content-Security-Policy; anything else keeps the Vite dev server working
APP_ENV=development
